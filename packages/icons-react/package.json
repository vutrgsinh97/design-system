{
  "name": "@vutrgsinh97/icons-react",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vutrgsinh97/design-system.git",
    "directory": "packages/icons-react"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Internal React icons generated from shared SVG sources",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "check:bundle": "node scripts/check-bundle.mjs",
    "dev": "node scripts/watch.mjs",
    "typecheck": "pnpm generate && tsc -p tsconfig.build.json --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0"
  }
}
