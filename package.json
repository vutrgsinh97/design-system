{
  "name": "design-system-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "pnpm --filter @company/ui-react-web build",
    "typecheck": "pnpm --filter @company/ui-react-web typecheck && pnpm --filter next-example typecheck && pnpm --filter vite-example typecheck",
    "check:bundle": "node apps/vite-example/scripts/check-bundle.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm check:bundle",
    "dev:next": "pnpm build && pnpm --parallel --filter @company/ui-react-web --filter next-example dev",
    "dev:vite": "pnpm build && pnpm --parallel --filter @company/ui-react-web --filter vite-example dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@changesets/changelog-git": "^0.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
